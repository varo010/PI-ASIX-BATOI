digraph G {
  graph [rankdir=TB, splines=polyline, nodesep=0.35, ranksep=0.45, bgcolor="white", fontname="Arial"];
  node  [shape=plaintext, fontname="Arial", fontsize=11];
  edge  [color="#000080", arrowhead=none, penwidth=1.3];
  dir [shape=box, style="rounded,filled", fillcolor="#000080", fontcolor="white", color="#000080", margin="0.25,0.08",
       label=<<b>Dirección / Gerencia</b><br/><font point-size="9">Socios fundadores</font>>];
  a1 [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#000080" bgcolor="#E8EAF6">
      <tr><td bgcolor="#C5CAE9"><b>Área de negocio</b></td></tr>
      <tr><td><b>Comercial</b><br/><font point-size="9">Captación y cuentas de marcas</font></td></tr>
      <tr><td><b>Gestión de marketplaces</b><br/><font point-size="9">Catálogo, precios, listings</font></td></tr>
      <tr><td><b>Marketing y Paid Media</b><br/><font point-size="9">Publicidad y contenidos</font></td></tr>
      <tr><td><b>Análisis de datos</b><br/><font point-size="9">Informes y reporting</font></td></tr></table>>];
  a2 [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#000080" bgcolor="#E8EAF6">
      <tr><td bgcolor="#C5CAE9"><b>Área de operaciones</b></td></tr>
      <tr><td><b>Logística y almacén</b><br/><font point-size="9">Recepción, picking, packing, envíos</font></td></tr>
      <tr><td><b>Atención al cliente</b><br/><font point-size="9">Pedidos, incidencias, reputación</font></td></tr></table>>];
  a3 [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#000080" bgcolor="#F2F2F2">
      <tr><td bgcolor="#D9D9D9"><b>Área de soporte</b></td></tr>
      <tr><td><b>Administración y finanzas</b><br/><font point-size="9">Facturación, compras, RR. HH.</font></td></tr>
      <tr><td><b>Sistemas / Informática</b><br/><font point-size="9">Supuesto: 1 persona + soporte externo</font></td></tr></table>>];
  dir -> a1 [headport=n, tailport=s]; dir -> a2 [headport=n, tailport=s]; dir -> a3 [headport=n, tailport=s];
}
