digraph C {
  graph [rankdir=LR, nodesep=0.2, ranksep=0.35, fontname="Arial", bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, fillcolor="#E8EAF6", color="#000080", penwidth=1.2, width=1.6, height=0.9];
  edge  [color="#000080", penwidth=1.5];
  b1 [label=<<b>Empresa</b><br/><font point-size="9">B1 · B2<br/>actividad y<br/>9 departamentos</font>>];
  b3 [label=<<b>Necesidades</b><br/><font point-size="9">B3<br/>N-01 … N-16</font>>];
  b4 [label=<<b>Oportunidades</b><br/><font point-size="9">B4<br/>OP-01 … OP-11</font>>];
  b5 [label=<<b>Proyecto</b><br/><font point-size="9">B5<br/>Proyecto NEXO<br/>13 elementos</font>>];
  b6 [label=<<b>Requisitos</b><br/><font point-size="9">B6<br/>RF-01 … RF-15<br/>RNF-01 … RNF-13</font>>, fillcolor="#000080", fontcolor="white"];
  b1 -> b3 -> b4 -> b5 -> b6;
}
